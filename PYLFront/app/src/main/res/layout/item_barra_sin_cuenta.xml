<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/RC_etbackground"
    android:orientation="horizontal"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="6dp"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="¿Desea acceder a más funciones? ¡Ingrese con una cuenta!"
        android:textColor="@android:color/black"
        android:textSize="14sp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnRegistrarseBarra"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="@color/IGO_bgBtnRegister"
            android:paddingVertical="10dp"
            android:textSize="13sp"
            android:paddingHorizontal="5dp"
            android:textStyle="bold"
            android:text="@string/IGO_register"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnIniciarSesionBarra"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_rounded"
            android:paddingVertical="10dp"
            android:paddingHorizontal="5dp"
            android:backgroundTint="@color/IGO_bgBtnLogin"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="@string/IGO_login"/>

    </LinearLayout>
</LinearLayout>